+++ b/gpu4pyscf/lib/response_cache.py
@@ -0,0 +1,40 @@
+"""Opt-in exact operator-image cache for the attribution experiment."""
+from __future__ import annotations
+import hashlib
+import cupy
+
+class ResponseOperatorCache:
+    """Bounded exact-image cache with counters for one SCF reference."""
+    def __init__(self, max_entries: int = 4096):
+        self.max_entries = int(max_entries)
+        self._values = {}
+        self.calls = self.hits = self.misses = 0
+
+    @staticmethod
+    def _key(row):
+        host = cupy.asnumpy(row)
+        return (str(host.dtype), tuple(host.shape), hashlib.sha256(host.tobytes()).hexdigest())
+
+    def wrap(self, fn):
+        """Return an ``fvind``-compatible function."""
+        def cached(value):
+            array = cupy.asarray(value)
+            if array.ndim < 2:
+                return fn(array)
+            original_shape = array.shape
+            rows = array.reshape(array.shape[0], -1)
+            outputs = []
+            for row in rows:
+                self.calls += 1
+                key = self._key(row)
+                if key in self._values:
+                    self.hits += 1
+                    outputs.append(self._values[key])
+                    continue
+                self.misses += 1
+                result = cupy.asarray(fn(row.reshape((1,) + original_shape[1:])))[0]
+                if len(self._values) < self.max_entries:
+                    self._values[key] = result.copy()
+                outputs.append(result)
+            return cupy.stack(outputs).reshape(original_shape)
+        return cached
