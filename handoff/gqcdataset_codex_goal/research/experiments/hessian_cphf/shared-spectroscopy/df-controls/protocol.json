    {"id": "water-DF-B3LYP", "atoms": [["O",[0,0,0]],["H",[0,1.4,0]],["H",[1.3,0,0]]], "charge": 0, "spin": 0, "method": "B3LYP", "finite_gradient_direction": false},
    {"id": "LiHplus-DF-UHF", "atoms": [["Li",[0,0,0]],["H",[3.015,0,0]]], "charge": 1, "spin": 1, "method": "UHF", "finite_gradient_direction": true}
  ]
